      },
      {
        "type": "list",
        "title": "Common pairs",
        "items": [
          [
            "Metformin → B12",
            "The diabetes medicine lowers B12 over time."
          ],
          [
            "Acid reducers → B12 & iron",
            "PPIs like omeprazole lower absorption of both."
          ],
          [
            "Thyroid pill + iron or calcium",
            "Take levothyroxine at least 4 hours apart from them."
          ],
          [
            "Steroids → vitamin D",
            "Medicines like prednisone lower vitamin D."
          ],
          [
            "Some antibiotics + magnesium",
            "Doxycycline or ciprofloxacin: take it 2 hours before or 4–6 hours after."
          ]
        ]
      },
      {
        "type": "text",
        "title": "What to do",
        "body": [
          "Don't stop or change any medicine on your own.",
          "Tell your doctor and pharmacist about every supplement you take, including multivitamins.",
          "Ask whether you need a B12 or vitamin D test if you've been on these for a long time."
        ]
      },
      {
        "type": "cta",
        "title": "Each vitamin page lists its interactions",
        "path": "myvitapals.com"
      }
    ]
